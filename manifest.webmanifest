{
  "name": "University Schedule | Amirmahdi",
  "short_name": "Uni Schedule",
  "id": "./index.html?app=uni-schedule",
  "description": "Academic planner and university schedule web app.",
  "lang": "fa",
  "dir": "rtl",
  "start_url": "./index.html?source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "browser"
  ],
  "handle_links": "preferred",
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "prefer_related_applications": false,
  "categories": ["education", "productivity"],
  "background_color": "#0f2027",
  "theme_color": "#0f2027",
  "shortcuts": [
    {
      "name": "برنامه کلاسی",
